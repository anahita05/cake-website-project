SECRET_KEY=Your secret key here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
GOOGLE_OAUTH_CLIENT_ID=Your google client ID here

# Google account linking (requires a Google-verified email)
ALLOW_GOOGLE_ACCOUNT_LINKING=True

# CORS / CSRF origins (comma separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies: keep these False/Lax in local dev (plain HTTP)
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# Optional shared cache for throttling (required with multiple workers)
REDIS_URL=

# Password reset links (frontend route + email sender)
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@cakeshop.local
PASSWORD_RESET_TIMEOUT=3600
